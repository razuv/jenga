# Default: P2P with public PeerJS signaling. No configuration or API keys required.
# Optional: use the previous Socket.IO backend instead of P2P.
# Optional online backend for the static frontend (must use HTTPS on GitHub Pages).
# VITE_SERVER_URL=https://your-jenga-server.example.com
# Server: allow the frontend origin (without the /jenga/ path).
# CLIENT_ORIGIN=https://razuv.github.io

# Optional managed STUN/TURN replacement. This entire JSON is public in the browser build.
# Use scoped/temporary TURN credentials, never a service API secret.
# VITE_ICE_SERVERS=[{"urls":"turns:relay.example.com:443?transport=tcp","username":"temporary-user","credential":"temporary-token"}]
